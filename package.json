{
  "name": "@c9up/relay",
  "version": "0.1.7",
  "description": "Relay — Realtime client transport for the Ream framework (SSE + WebSocket Hub + SignalR)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/RelayProvider.ts",
      "import": "./src/RelayProvider.ts"
    },
    "./services/main": {
      "types": "./src/services/main.ts",
      "import": "./src/services/main.ts"
    },
    "./testing": {
      "types": "./src/testing/FakeRelay.ts",
      "import": "./src/testing/FakeRelay.ts"
    }
  },
  "peerDependencies": {
    "@c9up/ream": "^0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check src/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^22.19.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./provider": {
        "types": "./dist/RelayProvider.d.ts",
        "import": "./dist/RelayProvider.js"
      },
      "./services/main": {
        "types": "./dist/services/main.d.ts",
        "import": "./dist/services/main.js"
      },
      "./testing": {
        "types": "./dist/testing/FakeRelay.d.ts",
        "import": "./dist/testing/FakeRelay.js"
      }
    },
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@c9up/ream": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/relay.git"
  }
}
